{
    /* Hand-edited statusbar configuration. These values are merged over the
       built-in defaults, which are documented in
       ~/.config/quickshell/StatusbarApp/config.json.
       Reload after editing: qs ipc call statusbar reload */
    "bar": {
        "enabled": true,
        "alwaysExpanded": true,
        "position": "bottom"
    },
    "modules": {
        "left": ["terminal", "workspaces"],
        "center": ["window"],
        "right": ["updates", "battery", "powerprofile", "volume", "systemtray", "logo", "swaync", "power", "clock"]
    },
    "window": {
        "rewrite": {
            "(.*) - Brave": "$1",
            "(.*) - Chromium": "$1",
            "(.*) - Brave Search": "$1",
            "(.*) - Outlook": "$1",
            "(.*) Microsoft Teams": "$1"
        }
    },
    "clock": {
        "format": "hh:mm AP"
    }
}
